# 仅供仓库根目录 docker compose 使用。复制为 .env 后改成实际值。
# 容器内 DB/Qdrant/Redis/MinIO 地址由 compose 写死；LLM/RERANK 地址用于宿主映射端口。

# ===== compose 插值 =====
SERVER_HOST_PORT=8808
WEB_HOST_PORT=5173
VITE_BASE=/

# 须与 cwc-infra 仓 .env 的 DB_USER / DB_PASSWORD 一致
# https://gdutsyjx.gdut.edu.cn/cwc/git/cwc/cwc-infra.git
DB_USER=infra
DB_PASSWORD=change-me
DB_NAME=rag

QDRANT_COLLECTION=knowledge-base
# 向量维度：0 或留空 = 启动时调用 embedding 服务自动探测；也可显式指定（如 1024）
QDRANT_VECTOR_SIZE=0

REDIS_PASSWORD=

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=myrag-documents

# 须与 cwc-infra 仓 llm/.env 的 LITELLM_MASTER_KEY 一致
LLM_API_KEY=sk-change-me
LLM_CHAT_MODEL=glm-4.6v-flash
LLM_EMBEDDING_MODEL=qwen3-vl-embedding-2b
LLM_VISION_MODEL=glm-4.6v-flash
# OCR 专用 vLLM OpenAI 兼容端点（cwc-infra/llm 默认宿主 8002 端口）
LLM_OCR_MODEL=ocr
LLM_OCR_BASE_URL=http://host.docker.internal:8002/v1
LLM_OCR_API_KEY=
LLM_BASE_URL=http://host.docker.internal:4000

# vLLM cross-encoder reranker（cwc-infra/llm，默认宿主 8003 端口）
RERANK_BASE_URL=http://host.docker.internal:8003
RERANK_MODEL=bge-reranker-v2-m3
RERANK_API_KEY=

# Neo4j 图谱（cwc-infra data 栈）
NEO4J_ENABLED=true
NEO4J_URI=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

JWT_SECRET=change-me
JWT_TTL_SECONDS=86400
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=系统管理员
