# ===== 服务 =====
PORT=8080
LOG_LEVEL=info

# ===== 宿主端口映射（compose 使用；容器内端口固定，不受影响） =====
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
MINIO_HOST_PORT=9100
MINIO_CONSOLE_HOST_PORT=9101
SERVER_HOST_PORT=8808
WEB_HOST_PORT=5173
# 前端部署子路径（必填；vite base 与 react-router basename 共用，如 / 或 /rag/）
VITE_BASE=/
# dev 代理后端地址（必填，vite.config 校验）
# 个人覆盖：在 apps/web/.env.local 写 BACK_END_URL=xxx（gitignored），或 BACK_END_URL=xxx pnpm dev
BACK_END_URL=http://localhost:8080

# ===== 数据库（PostgreSQL） =====
# DB_PORT 为本地开发连接宿主映射端口；compose 容器内已固定为 5432
DB_HOST=postgres
DB_PORT=5433
DB_USER=rag
DB_PASSWORD=rag_password
DB_NAME=rag

# ===== 向量库（Qdrant） =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge-base
# 必须与 embedding 模型输出维度一致
QDRANT_VECTOR_SIZE=2048

# ===== 状态存储（Redis，无状态化） =====
# REDIS_PORT 为本地开发连接宿主映射端口；compose 容器内已固定为 6379
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=

# ===== 对象存储（MinIO / S3 兼容；不配置则回退本地 uploadDir，生产必须配置） =====
# 格式 host[:port]；USE_SSL 对 https 端点置 true
MINIO_ENDPOINT=127.0.0.1:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=myrag-documents
# MINIO_USE_SSL=false

# ===== LLM（OpenAI 兼容） =====
LLM_BASE_URL=https://your-llm-gateway/v1
LLM_API_KEY=your-api-key
LLM_CHAT_MODEL=glm-4.6v-flash
LLM_EMBEDDING_MODEL=qwen3-vl-embedding-2b
LLM_VISION_MODEL=glm-4.6v-flash
LLM_OCR_MODEL=glm-ocr
LLM_TIMEOUT_MS=120000

# ===== LangSmith 可观测（可选；langchain 自动读取） =====
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=myrag

# ===== 认证 =====
# 生产环境务必修改
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=86400
# 访客 token 有效期（秒），默认 30 天；访客会话保留天数/清理开关在管理面板运行时设置
# GUEST_JWT_TTL_SECONDS=2592000
# 首次启动种子管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=系统管理员

# ===== RAG 参数（可选，均有默认值） =====
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_MAX_RESULTS=5
# RAG_MIN_SCORE=0.5
# RAG_BM25_WEIGHT=0.4
# RAG_CONTEXT_BUDGET=8000
# RAG_MEMORY_WINDOW=6
# RECOVERY_STALE_MS=300000
