# 仅供仓库根目录 docker compose 使用。复制为 .env 后改成实际值。
# 容器内 DB/Qdrant/Redis/MinIO/LLM 地址由 compose 写死，不要在这里配。

# ===== compose 插值 =====
SERVER_HOST_PORT=8808
WEB_HOST_PORT=5173
VITE_BASE=/

# 须与 infra/.env 的 DB_USER / DB_PASSWORD 一致
DB_USER=infra
DB_PASSWORD=change-me
DB_NAME=rag

QDRANT_COLLECTION=knowledge-base
QDRANT_VECTOR_SIZE=2048

REDIS_PASSWORD=

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=myrag-documents

# 须与 infra/llm/.env 的 LITELLM_MASTER_KEY 一致
LLM_API_KEY=sk-change-me
LLM_CHAT_MODEL=glm-4.6v-flash
LLM_EMBEDDING_MODEL=qwen3-vl-embedding-2b
LLM_VISION_MODEL=glm-4.6v-flash
LLM_OCR_MODEL=glm-ocr
LLM_BASE_URL=http://llm:8080

JWT_SECRET=change-me
JWT_TTL_SECONDS=86400
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_DISPLAY_NAME=系统管理员
