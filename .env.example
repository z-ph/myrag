# ===== 服务 =====
PORT=8080
LOG_LEVEL=info

# ===== 数据库（MySQL） =====
DB_HOST=mysql
DB_PORT=3306
DB_USER=rag
DB_PASSWORD=rag_password
DB_NAME=rag

# ===== 向量库（Qdrant） =====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=knowledge-base
# 必须与 embedding 模型输出维度一致
QDRANT_VECTOR_SIZE=2048

# ===== 状态存储（Redis，无状态化） =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== LLM（OpenAI 兼容） =====
LLM_BASE_URL=https://your-llm-gateway/v1
LLM_API_KEY=your-api-key
LLM_CHAT_MODEL=glm-4.6v-flash
LLM_EMBEDDING_MODEL=qwen3-vl-embedding-2b
LLM_VISION_MODEL=glm-4.6v-flash
LLM_OCR_MODEL=glm-ocr
LLM_TIMEOUT_MS=120000

# ===== 认证 =====
# 生产环境务必修改
JWT_SECRET=change-me-in-production
JWT_TTL_SECONDS=86400
# 首次启动种子管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=系统管理员

# ===== RAG 参数（可选，均有默认值） =====
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=50
# RAG_MAX_RESULTS=5
# RAG_MIN_SCORE=0.5
# RAG_BM25_WEIGHT=0.4
# RAG_CONTEXT_BUDGET=8000
# RAG_MEMORY_WINDOW=6
# RECOVERY_STALE_MS=300000
