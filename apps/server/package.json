{
  "name": "@myrag/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs",
    "build": "tsup && tsc --emitDeclarationOnly --declaration --noEmit false --outDir dist/types",
    "build:types": "tsc --emitDeclarationOnly --declaration --noEmit false --outDir dist/types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-openapi": "^1.5.1",
    "@langchain/core": "^1.2.4",
    "@langchain/openai": "^1.5.5",
    "@myrag/shared": "workspace:*",
    "@qdrant/js-client-rest": "^1.18.0",
    "@scalar/hono-api-reference": "^0.11.12",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.12.33",
    "ioredis": "^6.0.0",
    "jose": "^6.2.7",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "minio": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.0",
    "word-extractor": "^1.0.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
