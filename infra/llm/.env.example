# infra/llm/docker-compose.yml 插值变量。复制为 .env 后改成实际值。
# 容器内端口固定，不受影响。

# ===== 宿主端口映射 =====
VLLM_CHAT_HOST_PORT=8000
VLLM_EMBEDDING_HOST_PORT=8001
VLLM_OCR_HOST_PORT=8002
LITELLM_HOST_PORT=4000

# ===== LiteLLM =====
# 容器内仍用官方名 UI_USERNAME / UI_PASSWORD；compose 做映射
# yaml master_key 读 os.environ/LITELLM_MASTER_KEY
LITELLM_MASTER_KEY=sk-change-me
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

# ===== GPU（NVIDIA device_ids，从 0 计） =====
VLLM_CHAT_GPU=0
VLLM_EMBEDDING_GPU=0
VLLM_OCR_GPU=0

# ===== 宿主缓存路径 =====
MODELSCOPE_HOST_DIR=/home/USER/.cache/modelscope
VLLM_CHAT_VLLM_CACHE_DIR=/home/USER/.cache/glm-4.6-vl-flash/vllm
VLLM_CHAT_NV_CACHE_DIR=/home/USER/.cache/glm-4.6-vl-flash/.nv
VLLM_EMBEDDING_VLLM_CACHE_DIR=/home/USER/.cache/qwen3-embedding-4b/vllm
VLLM_EMBEDDING_NV_CACHE_DIR=/home/USER/.cache/qwen3-embedding-4b/.nv
VLLM_OCR_VLLM_CACHE_DIR=/home/USER/.cache/glm-ocr/vllm
VLLM_OCR_NV_CACHE_DIR=/home/USER/.cache/glm-ocr/.nv
