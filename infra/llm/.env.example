# infra/llm/docker-compose.yml 插值变量。复制为 .env 后改成实际值。
# 容器内端口固定，不受影响。

# ===== 宿主端口映射 =====
CHAT_HOST_PORT=8000
EMBEDDING_HOST_PORT=8001
OCR_HOST_PORT=8002
LITELLM_HOST_PORT=4000

# ===== LiteLLM =====
# 容器内仍用官方名 UI_USERNAME / UI_PASSWORD；compose 做映射
# yaml master_key 读 os.environ/LITELLM_MASTER_KEY
LITELLM_MASTER_KEY=sk-change-me
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

# ===== GPU（NVIDIA device_ids，从 0 计） =====
CHAT_GPU=0
EMBEDDING_GPU=0
OCR_GPU=0

# ===== 宿主缓存路径 =====
MODELSCOPE_HOST_DIR=/home/USER/.cache/modelscope

CHAT_CACHE_DIR=/home/USER/.cache/glm-4.6-vl-flash/vllm
CHAT_NV_CACHE_DIR=/home/USER/.cache/glm-4.6-vl-flash/.nv
CHAT_MODEL_PATH=/root/.cache/modelscope/hub/models/ZhipuAI/GLM-4___6V-Flash
CHAT_MODEL_NAME=glm-4.6v-flash
CHAT_GPU_MEMORY_UTILIZATION=0.7
CHAT_TOOL_CALL_PARSER=glm45
CHAT_MAX_MODEL_LEN=64000
CHAT_REASONING_PARSER=glm45

EMBEDDING_CACHE_DIR=/home/USER/.cache/qwen3-embedding-4b/vllm
EMBEDDING_NV_CACHE_DIR=/home/USER/.cache/qwen3-embedding-4b/.nv
EMBEDDING_MODEL_PATH=/root/.cache/modelscope/hub/models/Qwen/Qwen3-VL-Embedding-2B
EMBEDDING_MODEL_NAME=qwen3-vl-embedding-2b
EMBEDDING_GPU_MEMORY_UTILIZATION=0.21
EMBEDDING_MAX_MODEL_LEN=32000

OCR_CACHE_DIR=/home/USER/.cache/glm-ocr/vllm
OCR_NV_CACHE_DIR=/home/USER/.cache/glm-ocr/.nv
OCR_MODEL_PATH=/root/.cache/modelscope/hub/models/ZhipuAI/GLM-OCR
OCR_MODEL_NAME=glm-ocr
OCR_GPU_MEMORY_UTILIZATION=0.1
OCR_MAX_MODEL_LEN=25000